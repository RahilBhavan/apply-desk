{
  "manifest_version": 3,
  "name": "Apply Desk",
  "version": "0.2.0",
  "description": "Prepare applications from your private Apply Desk workspace.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prepare application"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "minimum_chrome_version": "106",
  "key": ""
}